# Copy to .env.local for local dev. On Vercel, set these under Project → Settings → Environment Variables.
DATABASE_URL=            # Neon Postgres (Vercel Storage → Neon sets this)
RESEND_API_KEY=          # sends the 6-digit verification/reset emails
AUTH_SECRET=             # optional; defaults to a key derived from DATABASE_URL
EMAIL_FROM=              # optional; default "GovShredz <govshredz@neqodigital.com>"
